# Aegis Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Origins the FastAPI CORS middleware will accept (comma-separated)
AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute or relative path to the SQLite database file
AEGIS_DB_PATH=aegis.db

# Absolute or relative path to the trained model artifact
AEGIS_MODEL_PATH=src/aegis_model.pkl

# Telemetry source: "local" uses psutil for CPU/memory, "simulated" generates all metrics synthetically
AEGIS_TELEMETRY_SOURCE=local

# How many telemetry snapshots to retain in history (trimmed on write)
AEGIS_TELEMETRY_HISTORY_LIMIT=500
